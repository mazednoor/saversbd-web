# WordPress backend (no trailing slash)
WORDPRESS_URL=https://saversbd.com

# Public origin of the Next.js frontend — used for canonical URLs and sitemap
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Content cache lifetime in seconds (ISR)
NEXT_PUBLIC_REVALIDATE=600

# Set to 1 only if your WP host blocks the Next.js image optimizer
# NEXT_PUBLIC_UNOPTIMIZED_IMAGES=1

# Homepage hero photo (absolute URL). Defaults to the slider image on saversbd.com.
# NEXT_PUBLIC_HERO_IMAGE=https://saversbd.com/wp-content/uploads/2025/01/slider-1-scaled.webp

# Revalidate the frontend after WordPress publishes something.
# Create a WordPress Application Password and put the credentials on the
# frontend server only — never in the browser bundle.
# REVALIDATE_SECRET=change-me-to-a-long-random-string
